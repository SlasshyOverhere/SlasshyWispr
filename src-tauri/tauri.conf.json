{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SlasshyWispr",
  "version": "0.1.2",
  "identifier": "online.slasshy.desktop.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SlasshyWispr",
        "width": 1280,
        "height": 920,
        "minWidth": 980,
        "minHeight": 860,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
