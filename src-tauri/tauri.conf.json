{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SlasshyWispr",
  "version": "1.0.7",
  "identifier": "online.slasshy.slasshywispr",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SlasshyWispr",
        "width": 1280,
        "height": 832,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com asset:; img-src 'self' asset: data:; media-src 'self' asset: data: blob:; connect-src 'self' ws: wss: asset:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
